---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-end">
              <fieldset class="flex-1">
                <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="inline-flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <label class="flex min-w-56 flex-col gap-2 text-sm font-semibold text-slate-200">
                <span>Filter by publisher</span>
                <select
                  name="publisher"
                  class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 font-normal text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </label>

              <button
                type="reset"
                class="rounded-lg bg-slate-700 px-4 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-600 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>
          </form>

          <p class="mb-4 text-sm text-slate-400" data-testid="filter-results-count" aria-live="polite">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');

  filterForm?.addEventListener('change', () => {
    const selectedCategories = new Set(
      Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')).map(
        (input) => input.value,
      ),
    );
    const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
    let visibleCount = 0;

    for (const card of cards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches = selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const isVisible = categoryMatches && publisherMatches;
      card.hidden = !isVisible;
      visibleCount += isVisible ? 1 : 0;
    }

    grid?.classList.toggle('hidden', visibleCount === 0);
    emptyState?.classList.toggle('hidden', visibleCount !== 0);
    if (resultCount) {
      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    }
  });

  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(() => filterForm.dispatchEvent(new Event('change')));
  });
</script>
